   "dai": "さ寢ーさは發語",
   "kotobagaki": "",
   "author": "",
   "author_ocr": "",
   "author_resolved": "",
   "shuttei": "",
   "text": "ヲヲヲヲ。ハレナ。手を調へろな。歌と〓のへむな。さかむのねェ。ヲヲヲヲ。",
   "yomi": "",
   "sachu": "",
   "jo": false,
   "pages": [
